---
interface Props {
  /** The numeric share id from the LinkedIn post URL. */
  id: string;
}

const { id } = Astro.props;

/**
 * Optional LinkedIn embed, for the posts where the thread itself is the
 * artifact — a good comment section is worth showing.
 *
 * Three things this has to get right:
 *
 * 1. LinkedIn's own snippet hardcodes a pixel width that overflows on mobile.
 *    The wrapper below uses an aspect-ratio box with the iframe stretched to
 *    fill it, so the embed is responsive regardless of what LinkedIn ships.
 * 2. It's lazy-loaded, so it never costs anything above the fold and never
 *    blocks the page's Lighthouse score.
 * 3. The page never depends on it. If LinkedIn is down, blocked by a content
 *    blocker, or the id is wrong, the reader loses a comment thread and
 *    nothing else — the post above it is complete on its own.
 */

const src = `https://www.linkedin.com/embed/feed/update/urn:li:share:${id}`;
---

<section class="mt-10" aria-labelledby="linkedin-thread">
  <h2 id="linkedin-thread" class="annotation border-line border-b pb-2">The LinkedIn thread</h2>

  <div class="embed-frame border-line mt-5 border">
    <iframe src={src} title="LinkedIn post and discussion" loading="lazy" allowfullscreen></iframe>
  </div>

  <p class="text-ink-muted mt-3 text-xs">
    Embedded from LinkedIn. If it doesn't load, the post above is the whole piece.
  </p>
</section>

<style>
  /* Aspect-ratio box. LinkedIn's embeds are tall and narrow; this keeps the
     frame proportional down to 375px instead of forcing a horizontal scroll. */
  .embed-frame {
    position: relative;
    width: 100%;
    max-width: 34rem;
    aspect-ratio: 5 / 6;
  }

  .embed-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
