---
import { getPlatforms, getPublishedCaseStudyPaths } from '../lib/content';

/**
 * THE PLATFORM FLUENCY MATRIX — built as a patch panel.
 *
 * This is the one place the design spends boldness. Everything around it stays
 * quiet so this can be the thing a reader remembers.
 *
 * The metaphor is doing real work rather than decorating. On a physical patch
 * panel, a port with a cable seated in it is carrying traffic; a port without
 * one exists and is ready but isn't connected to anything. That is exactly the
 * difference between a platform Justin has built on and one he can only
 * evaluate — so the distinction the brief insists must be visible becomes the
 * literal form of the component instead of a footnote under it.
 *
 * Accessibility: implemented as a tab pattern. Arrow keys move between ports,
 * Home/End jump to the ends, and the readout is the tabpanel. Without
 * JavaScript every readout renders stacked and visible — the script only adds
 * the `data-enhanced` flag that switches on the one-at-a-time behavior, so a
 * no-JS reader loses the interaction but none of the information.
 */

const platforms = await getPlatforms();
const published = await getPublishedCaseStudyPaths();

const handsOn = platforms.filter((p) => p.data.tier === 'hands-on');
const familiarity = platforms.filter((p) => p.data.tier === 'familiarity');

const CATEGORY_LABELS: Record<string, string> = {
  ccaas: 'CCaaS',
  ucaas: 'UCaaS',
  enablement: 'Enablement',
  crm: 'CRM',
};

/** Drop evidence links that point at a case study excluded from this build. */
const evidenceFor = (entry: (typeof platforms)[number]) => {
  const ev = entry.data.evidence;
  if (!ev) return null;
  const internal = ev.href.startsWith('/');
  if (internal && ev.href.startsWith('/work/') && !published.has(ev.href)) return null;
  return ev;
};

const groups = [
  {
    tier: 'hands-on' as const,
    heading: 'Hands-on build',
    note: "Configured, administered, integrated, or delivered. I've hit the undocumented behavior on these.",
    items: handsOn,
  },
  {
    tier: 'familiarity' as const,
    heading: 'Landscape familiarity',
    note: 'I can evaluate these, position them, and ask the right questions. I have not delivered on them.',
    items: familiarity,
  },
];
---

<section class="patch" aria-labelledby="matrix-heading" data-patch>
  <div class="max-w-measure">
    <p class="annotation">Platform fluency</p>
    <h2 id="matrix-heading" class="font-display mt-3 text-2xl font-semibold sm:text-3xl">
      What I've built on, and what I've only evaluated
    </h2>
    <p class="text-ink-muted mt-4">
      Most people in this market present one list. These are two, and the line between them is the
      useful part. Select any platform to see what the work actually was.
    </p>
  </div>

  <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-12">
    <!-- The panel itself -->
    <div>
      {
        groups.map((group) => (
          <div class="tier" data-tier={group.tier}>
            <div class="tier-head">
              <h3 class="annotation tier-title">
                {group.heading}
                <span class="tier-count">({group.items.length})</span>
              </h3>
              <p class="text-ink-muted mt-1.5 max-w-md text-sm">{group.note}</p>
            </div>

            <div class="ports" role="tablist" aria-label={group.heading}>
              {group.items.map((p) => (
                <button
                  type="button"
                  role="tab"
                  id={`port-${p.id}`}
                  class="port"
                  data-port={p.id}
                  data-tier={p.data.tier}
                  aria-controls={`readout-${p.id}`}
                  aria-selected="false"
                  tabindex="-1"
                >
                  <span class="jack" aria-hidden="true" />
                  <span class="port-name font-display text-sm font-semibold">{p.data.name}</span>
                  <span class="annotation port-cat">{CATEGORY_LABELS[p.data.category]}</span>
                  {/* Spelled out for screen readers, since the cable is purely visual. */}
                  <span class="sr-only">
                    {p.data.tier === 'hands-on' ? '· hands-on build' : '· landscape familiarity'}
                  </span>
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- The readout. Sticky on desktop so the panel stays in view while
         reading; static on mobile where it sits below. -->
    <div class="readouts lg:sticky lg:top-24 lg:self-start">
      <p class="annotation readout-label">Readout</p>
      {
        platforms.map((p) => {
          const ev = evidenceFor(p);
          return (
            <div
              class="readout"
              id={`readout-${p.id}`}
              role="tabpanel"
              aria-labelledby={`port-${p.id}`}
              tabindex="0"
            >
              <div class="flex items-baseline justify-between gap-3">
                <h4 class="font-display text-lg font-semibold">{p.data.name}</h4>
                <span
                  class:list={[
                    'annotation shrink-0',
                    p.data.tier === 'hands-on' ? 'text-copper' : 'text-ink-muted',
                  ]}
                >
                  {p.data.tier === 'hands-on' ? 'Patched' : 'Unpatched'}
                </span>
              </div>
              <p class="text-ink-muted mt-3 text-sm leading-relaxed">{p.data.detail}</p>
              {ev && (
                <a
                  href={ev.href}
                  class="text-signal mt-4 inline-block text-sm underline underline-offset-4"
                >
                  {ev.label} →
                </a>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .patch {
    /* The panel gets its own ground so it reads as a piece of equipment set
       into the page rather than another content block. */
    background: var(--c-surface);
    border-block: 1px solid var(--c-line);
    padding-block: 3.5rem;
    padding-inline: 1.25rem;
  }

  @media (min-width: 48rem) {
    .patch {
      padding-block: 5rem;
      padding-inline: 2rem;
    }
  }

  /* Center the panel's contents on the same measure as the rest of the site. */
  .patch > * {
    max-width: 72rem;
    margin-inline: auto;
  }

  .tier + .tier {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px dashed var(--c-line);
  }

  .tier-title {
    color: var(--c-ink);
  }

  .tier-count {
    color: var(--c-ink-muted);
    margin-left: 0.375rem;
  }

  .ports {
    margin-top: 1.25rem;
    display: grid;
    /* Two up at 375px, filling out as space allows. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  @media (min-width: 30rem) {
    .ports {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .ports {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* --- A port ------------------------------------------------------------*/

  .port {
    position: relative;
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.875rem 0.75rem 0.75rem;
    background: var(--c-ground);
    border: 1px solid var(--c-line);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms ease;
  }

  .port:hover {
    border-color: var(--c-ink-muted);
  }

  /* An unpatched port is drawn dashed — the cell exists, nothing is seated in
     it. This is the tier distinction carried by form rather than by color
     alone, which also keeps it legible to anyone who can't separate the two
     hues. */
  .port[data-tier='familiarity'] {
    border-style: dashed;
    background: transparent;
  }

  .port-name {
    display: block;
    /* Clears the jack sitting in the top-right corner. */
    padding-right: 1.25rem;
  }

  .port-cat {
    display: block;
    margin-top: 0.125rem;
  }

  /* The jack. Filled with a cable seated for hands-on; a hollow ring for
     familiarity. */
  .jack {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 1px solid var(--c-line);
    background: transparent;
  }

  .port[data-tier='hands-on'] .jack {
    border-color: var(--c-copper);
    background: var(--c-copper);
    box-shadow: 0 0 0 3px var(--c-copper-wash);
  }

  /* The cable. A short lead running from the jack up and out through the top
     of the panel, the way a patched port actually looks. Drawn on the port
     rather than inside the jack so the jack's border-radius can't clip it, and
     routed vertically so it never collides with the platform name.

     This is the detail that makes the tier distinction land as a picture
     instead of as a legend someone has to read. */
  .port[data-tier='hands-on']::after {
    content: '';
    position: absolute;
    top: -1px;
    right: 1.0625rem;
    width: 1px;
    height: 0.8125rem;
    background: var(--c-copper);
  }

  /* An unpatched port still needs to read as a port. Without this the hollow
     jack disappears into the dashed cell and looks like a rendering artifact
     rather than a deliberate empty socket. */
  .port[data-tier='familiarity'] .jack {
    border-color: var(--c-ink-muted);
    border-style: solid;
  }

  /* Selected state. Border and a left rule, so selection is never color-only. */
  .port[aria-selected='true'] {
    border-color: var(--c-signal);
    border-style: solid;
    background: var(--c-signal-wash);
  }

  .port[aria-selected='true']::before {
    content: '';
    position: absolute;
    inset-block: -1px;
    left: -1px;
    width: 3px;
    background: var(--c-signal);
  }

  /* --- Readout -----------------------------------------------------------*/

  .readouts {
    border: 1px solid var(--c-line);
    padding: 1.25rem;
    background: var(--c-ground);
  }

  .readout-label {
    margin-bottom: 0.875rem;
  }

  .readout + .readout {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
  }

  /* Without JS every readout stays visible and stacked — all the information,
     none of the interaction. The script sets data-enhanced, which switches on
     one-at-a-time display. */
  [data-patch][data-enhanced='true'] .readout {
    display: none;
  }

  [data-patch][data-enhanced='true'] .readout[data-active='true'] {
    display: block;
    animation: readout-in 200ms ease both;
  }

  [data-patch][data-enhanced='true'] .readout + .readout {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  @keyframes readout-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  /**
   * Tab-pattern behavior for the patch panel.
   *
   * Ports are split across two tablists (one per tier) but behave as a single
   * roving-tabindex group, so arrow keys walk the whole panel rather than
   * stopping at the tier boundary. Only one port is in the tab order at a
   * time; Tab moves past the panel entirely, which is the expected behavior
   * for this pattern.
   */
  const root = document.querySelector<HTMLElement>('[data-patch]');

  if (root) {
    const ports = Array.from(root.querySelectorAll<HTMLButtonElement>('.port'));
    const readouts = Array.from(root.querySelectorAll<HTMLElement>('.readout'));

    // Switch on one-at-a-time display only now that the script is running.
    root.dataset.enhanced = 'true';

    function select(index: number, moveFocus = false) {
      const port = ports[index];
      if (!port) return;

      ports.forEach((p, i) => {
        const selected = i === index;
        p.setAttribute('aria-selected', String(selected));
        // Roving tabindex: exactly one port is tabbable.
        p.tabIndex = selected ? 0 : -1;
      });

      const id = port.dataset.port;
      readouts.forEach((r) => {
        r.dataset.active = String(r.id === `readout-${id}`);
      });

      if (moveFocus) port.focus();
    }

    ports.forEach((port, i) => {
      port.addEventListener('click', () => select(i));

      port.addEventListener('keydown', (event) => {
        const keys = ['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'];
        if (!keys.includes(event.key)) return;
        event.preventDefault();

        let next = i;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (i + 1) % ports.length;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp')
          next = (i - 1 + ports.length) % ports.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = ports.length - 1;

        select(next, true);
      });
    });

    // Open on the first hands-on platform, so the panel starts by showing the
    // stronger claim rather than an empty readout.
    select(0);
  }
</script>
