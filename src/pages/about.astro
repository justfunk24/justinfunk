---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { getRecommendations } from '../lib/content';
import Recommendation from '../components/Recommendation.astro';

// Only quotes with `permission: true` come back. All eight are Justin's own
// LinkedIn recommendations, reproduced verbatim and published at his request.
const recommendations = await getRecommendations();
---

<Base
  title="About"
  description={`${site.name} — MBA, University of Denver. Enterprise CX and contact center practitioner in Denver, now building agentic AI environments.`}
>
  <div class="shell pt-14 pb-20 sm:pt-20">
    <p class="annotation">About</p>
    <h1 class="font-display mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl">
      A decade of watching good technology fail for non-technical reasons
    </h1>

    <div class="mt-12 grid gap-14 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
      <div class="max-w-measure">
        <div class="text-[1.0625rem] leading-relaxed">
          <p>
            I've spent more than a decade in and around cloud communications — carrying a $30M+
            enterprise portfolio at AT&amp;T, three roles across two stints at RingCentral, building
            an enablement and sales ops function from scratch at Cloud Elements, and owning the
            compensation enablement program 400+ sellers relied on at Twilio.
          </p>
          <p class="mt-5">
            The pattern that shows up everywhere: the platform was almost never the problem. Someone
            bought good software and then nobody used it the way it was meant to be used, or the
            rollout skipped the part where you find out what people actually do all day. Fixing that
            is unglamorous and it's most of the job.
          </p>
          <p class="mt-5">
            Then I spent three years as a financial advisor, which sounds like a detour and wasn't.
            It's where I championed the rollout of an internal GPT knowledge system to a team of ten
            in a regulated environment — not as the AI person, but as one of the people whose day it
            was supposed to improve. The same adoption problem I'd been watching for a decade, on a
            much faster clock and with a much higher cost of being wrong.
          </p>
          <p class="mt-5">
            Now at Matrice IT Advisors I build full contact center environments on Zoom and Dialpad
            — agentic voice and chat agents, quality and workforce management, intent-based skill
            paths into connected APIs, and the guardrails and human handoff that decide whether any
            of it survives production. I'm Dialpad Contact Center &amp; Agentic Delivery Partner
            certified, and Python 3 certified through Codecademy — because I'd rather read the
            integration code than be briefed on it.
          </p>
          <p class="mt-5">
            I'm in Denver. I earned my MBA at the University of Denver while working full time,
            which is a slower way to do it and taught me more about prioritization than any of the
            coursework did.
          </p>
        </div>

        <!-- Recommendations -->
        <section class="mt-16" aria-labelledby="recommendations">
          <h2 id="recommendations" class="annotation border-line border-b pb-2">
            What colleagues say
          </h2>

          {
            recommendations.length > 0 ? (
              <ul class="mt-8 grid gap-10">
                {recommendations.map((rec) => (
                  <li>
                    <Recommendation rec={rec} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-ink-muted border-line mt-6 border border-dashed p-4 text-sm">
                Nothing here yet. Quotes only appear on this page once the person who wrote them has
                given written permission to publish — the same standard as every other claim on this
                site.
              </p>
            )
          }
        </section>
      </div>

      <!-- Credentials sidebar -->
      <aside class="grid content-start gap-10">
        <div>
          <h2 class="annotation border-line border-b pb-2">Education</h2>
          <ul class="mt-4 grid gap-3 text-sm">
            {
              site.alumniOf.map((school) => (
                <li>
                  <p class="font-medium">{school.credential}</p>
                  <p class="text-ink-muted">
                    {school.name}, {school.year}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="annotation border-line border-b pb-2">Certifications</h2>
          <ul class="mt-4 grid gap-3 text-sm">
            {
              site.certifications.map((cert) => (
                <li>
                  <p class="font-medium">{cert.name}</p>
                  <p
                    class:list={[
                      'text-xs',
                      cert.status === 'Certified' ? 'text-copper' : 'text-ink-muted',
                    ]}
                  >
                    {cert.status}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="annotation border-line border-b pb-2">Speaking</h2>
          <ul class="mt-4 grid gap-3 text-sm">
            <li>
              <p class="font-medium">Docebo user conference, Toronto</p>
              <p class="text-ink-muted">
                Invited to speak on the sales onboarding and certification program built at Cloud
                Elements.
              </p>
            </li>
          </ul>
        </div>

        <div class="border-line border-t pt-6">
          <a href="/resume" class="text-signal text-sm underline underline-offset-4">
            Full resume →
          </a>
        </div>
      </aside>
    </div>
  </div>
</Base>
