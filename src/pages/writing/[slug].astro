---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import LinkedInEmbed from '../../components/LinkedInEmbed.astro';
import { site } from '../../lib/site';
import { getPosts, formatDate } from '../../lib/content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.hook,
  datePublished: post.data.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: site.name, url: site.url },
  publisher: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/writing/${post.id}`, site.url).href,
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
};
---

<Base
  title={post.data.title}
  description={post.data.hook}
  ogType="article"
  canonical={post.data.canonical}
  schema={schema}
>
  <article>
    <header class="shell pt-12 pb-10 sm:pt-16">
      <a href="/writing" class="annotation hover:text-signal transition-colors">
        <span aria-hidden="true">←</span> Injection of Funk
      </a>

      <p class="annotation mt-8">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>
          {formatDate(post.data.date)}
        </time>
      </p>

      <h1 class="font-display mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl">
        {post.data.title}
      </h1>

      {
        post.data.tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tags">
            {post.data.tags.map((tag) => (
              <li class="border-line text-ink-muted border px-2 py-0.5 font-mono text-[0.6875rem]">
                {tag}
              </li>
            ))}
          </ul>
        )
      }

      {
        post.data.draft && (
          <p class="border-copper bg-copper-wash mt-8 border-l-4 p-4 text-sm">
            <strong class="font-semibold">Draft.</strong> Visible in development only.
          </p>
        )
      }
    </header>

    <Prose>
      <Content />
    </Prose>

    <footer class="shell mt-14">
      {
        post.data.question && (
          <div class="border-line max-w-measure border-t pt-8">
            <p class="annotation">Your turn</p>
            <p class="font-display mt-2 text-lg font-medium">{post.data.question}</p>
            {post.data.linkedinUrl && (
              <a
                href={post.data.linkedinUrl}
                rel="noopener"
                class="text-signal mt-3 inline-block text-sm underline underline-offset-4"
              >
                Discuss on LinkedIn →
              </a>
            )}
          </div>
        )
      }

      {/* Optional, lazy-loaded, and the page never depends on it rendering. */}
      {post.data.linkedinEmbedId && <LinkedInEmbed id={post.data.linkedinEmbedId} />}

      <div class="border-line mt-10 border-t pt-8">
        <a href="/writing" class="text-signal text-sm underline underline-offset-4">
          More writing
        </a>
      </div>
    </footer>
  </article>
</Base>
