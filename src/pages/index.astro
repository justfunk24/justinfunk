---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import { site } from '../lib/site';
import { getCaseStudies, getProjects } from '../lib/content';
import headshot from '../assets/justin-funk.jpeg';

const caseStudies = await getCaseStudies();
const projects = await getProjects();

/* The three lanes.

   Each carries its own badge and link label rather than a shared one. That
   sounds fussy but it is the difference between a label that is true and one
   that is merely plausible: case studies are ordered by editorial priority,
   projects by date, and About has no feed at all — so a blanket "Most recent"
   would have been accurate for exactly one of the three.

   The link label names its destination ("All case studies") instead of a bare
   "All", because the arrow sits at the right edge of a column and a reader
   could reasonably read it as pointing at the next column rather than into
   this one. */

// The newest credential, which is what "recent" means for the About lane.
// Certifications without a recorded date are skipped rather than assumed.
const datedCerts = site.certifications.filter((c) => c.earned !== null);
const latestCert = [...datedCerts].sort((a, b) =>
  (b.earned ?? '').localeCompare(a.earned ?? ''),
)[0];

const lanes = [
  {
    label: 'Work',
    href: '/work',
    linkLabel: 'All case studies',
    blurb: 'Case studies with the metric as the headline.',
    // getCaseStudies sorts by `order`, so this is the featured study, not the
    // newest one. Labelled for what it is.
    badge: 'Featured',
    item: caseStudies[0]
      ? {
          title: caseStudies[0].data.title,
          href: `/work/${caseStudies[0].id}`,
          meta: caseStudies[0].data.company,
        }
      : null,
  },
  {
    label: 'Projects',
    href: '/projects',
    linkLabel: 'All projects',
    blurb: 'The build log, including work still in progress.',
    // getProjects sorts newest first, so this badge is literally true.
    badge: 'Most recent',
    item: projects[0]
      ? {
          title: projects[0].data.title,
          href: `/projects/${projects[0].id}`,
          meta: projects[0].data.stack.slice(0, 3).join(' · '),
        }
      : null,
  },
  {
    label: 'About',
    href: '/about',
    linkLabel: 'Full background',
    blurb: 'Background, credentials, and certifications.',
    badge: 'Latest certification',
    item: latestCert ? { title: latestCert.name, href: '/about', meta: latestCert.status } : null,
  },
];
/* JSON-LD Person. This is the block an AI screening tool or a chatbot reads
   when someone asks about Justin, so it states the same things the page does
   rather than a marketing version of them. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.tagline,
  url: site.url,
  email: `mailto:${site.email}`,
  // Absolute URL — schema.org consumers won't resolve a site-relative path,
  // and this is the image a search result or an AI screening tool shows.
  image: new URL(headshot.src, site.url).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.city,
    addressRegion: site.location.region,
    addressCountry: site.location.country,
  },
  knowsAbout: site.knowsAbout,
  alumniOf: site.alumniOf.map((school) => ({
    '@type': 'CollegeOrUniversity',
    name: school.name,
  })),
  sameAs: [site.linkedin, site.github],
};
---

<Base title={`${site.name} — ${site.role}`} description={site.tagline} schema={schema}>
  <Hero />
  <ProofStrip />

  <!-- Three lanes -->
  <section class="shell py-16 sm:py-24" aria-labelledby="lanes-heading">
    <h2 id="lanes-heading" class="sr-only">Explore</h2>

    {
      /* A real gutter, not the hairline gap-px this had: each lane ends in a
          right-aligned link, and with columns effectively touching, that link
          sat directly against the next lane's heading and read as pointing at
          it. gap-y keeps the stacked mobile layout breathing too. */
    }
    <div class="grid gap-x-10 gap-y-12 sm:grid-cols-3">
      {
        lanes.map((lane) => (
          <div class="flex flex-col">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-lg font-semibold">{lane.label}</h3>
              <a href={lane.href} class="annotation hover:text-signal transition-colors">
                {lane.linkLabel} →
              </a>
            </div>
            <p class="text-ink-muted mt-2 text-sm">{lane.blurb}</p>

            {lane.item ? (
              <a
                href={lane.item.href}
                class="border-line hover:border-signal hover:bg-signal-wash group mt-5 block flex-1 border p-4 transition-colors"
              >
                <span class="annotation">{lane.badge}</span>
                <span class="font-display group-hover:text-signal mt-2 block font-semibold transition-colors">
                  {lane.item.title}
                </span>
                <span class="text-ink-muted mt-1.5 block text-sm">{lane.item.meta}</span>
              </a>
            ) : (
              <p class="border-line text-ink-muted mt-5 flex-1 border border-dashed p-4 text-sm">
                Nothing published here yet.
              </p>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <!-- Closing CTA. One primary action, one secondary. -->
  <section class="shell pb-8">
    <div class="border-line border-t pt-10">
      <h2 class="font-display max-w-2xl text-2xl font-semibold sm:text-3xl">
        I'm looking for my next CX or applied-AI role.
      </h2>
      <p class="text-ink-muted max-w-measure mt-3">
        If you're hiring, the fastest version of this conversation starts with what your contact
        center is actually struggling with.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-4">
        <a
          href="/contact"
          class="bg-ink text-ground hover:bg-signal px-5 py-2.5 text-sm font-medium transition-colors"
        >
          Let's talk
        </a>
        <a
          href="/resume"
          class="border-line hover:border-signal hover:text-signal border px-5 py-2.5 text-sm transition-colors"
        >
          Read the resume
        </a>
      </div>

      {
        /* The footer CTA is suppressed on this page, so the direct email lives
          here instead — otherwise the homepage would be the only page without
          a plain address on it. */
      }
      <p class="mt-5">
        <a
          href={`mailto:${site.email}`}
          class="text-ink-muted hover:text-ink text-sm underline underline-offset-4 transition-colors"
        >
          Or email {site.email}
        </a>
      </p>
    </div>
  </section>
</Base>
