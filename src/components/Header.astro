---
import { nav, site } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

/** A nav item is "current" on its own page and on anything nested under it,
 *  so /work/matrice still highlights Work. */
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-line bg-ground/85 sticky top-0 z-50 border-b backdrop-blur">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="font-display hover:text-signal text-[0.9375rem] font-semibold tracking-tight transition-colors"
      aria-label={`${site.name} — home`}
    >
      {site.name}
    </a>

    <nav aria-label="Main" class="flex items-center gap-1">
      {
        /* The full nav collapses to a horizontally scrollable strip rather than
          a hamburger. Five short items fit on a 375px screen, and a menu that
          costs a tap is worse than a menu you can see. */
      }
      <ul class="-mx-1 flex scrollbar-none items-center gap-0.5 overflow-x-auto px-1 sm:gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'block px-2 py-1.5 text-sm whitespace-nowrap transition-colors sm:px-3',
                  isCurrent(item.href) ? 'text-ink font-medium' : 'text-ink-muted hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="ml-1 flex items-center gap-2 sm:ml-2">
        <a
          href="/contact"
          class="border-line hover:border-signal hover:text-signal hidden border px-3 py-1.5 text-sm transition-colors sm:block"
        >
          Contact
        </a>
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  /* Hide the scrollbar on the nav strip without disabling scrolling. */
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
