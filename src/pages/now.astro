---
import Base from '../layouts/Base.astro';

/**
 * A /now page. Short, current, dated.
 *
 * The only thing that makes this page work is the date at the top being
 * recent. If it goes stale it actively signals the opposite of what it's for,
 * so keep it cheap to update — this is deliberately a single file with plain
 * lists rather than another content collection to maintain.
 */

// PLACEHOLDER — Justin: update this date whenever you edit the page below.
const updated = new Date('2026-08-16T00:00:00Z');

const building = [
  'Agentic contact center environments on Zoom and Dialpad at Matrice.',
  'This site — the build log entry for it is the most honest documentation I have.',
];

const learning = [
  'Python 3 certification. Slower than I expected; the useful part has been reading integration code instead of being briefed on it.',
  'RingCentral and NICE platform certifications, in progress.',
];

const thinking = [
  'How to measure agentic containment without flattering the number. Abandonment and repeat contacts belong next to it.',
  'Why enablement content fails the same way knowledge bases do, and whether retrieval actually changes that.',
];
---

<Base
  title="Now"
  description="What Justin Funk is building, learning, and thinking about this month."
>
  <div class="shell pt-14 pb-20 sm:pt-20">
    <p class="annotation">
      Now · updated <time datetime={updated.toISOString().slice(0, 10)}>
        {updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}
      </time>
    </p>

    <h1 class="font-display mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl">
      What I'm actually doing this month
    </h1>

    <p class="text-ink-muted max-w-measure mt-5">
      Current as of the date above. If that date is old, this page is lying to you and I'd want to
      know.
    </p>

    <div class="mt-14 grid gap-12 sm:grid-cols-3 sm:gap-8">
      {
        [
          { heading: 'Building', items: building },
          { heading: 'Learning', items: learning },
          { heading: 'Thinking about', items: thinking },
        ].map((group) => (
          <section>
            <h2 class="annotation border-line border-b pb-2">{group.heading}</h2>
            <ul class="mt-5 grid gap-4">
              {group.items.map((item) => (
                <li class="relative pl-4 text-sm leading-relaxed">
                  <span class="bg-signal absolute top-[0.6875rem] left-0 h-px w-[0.4375rem]" />
                  {item}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p class="text-ink-muted border-line max-w-measure mt-16 border-t pt-8 text-sm">
      Borrowed from <a
        href="https://nownownow.com/about"
        rel="noopener"
        class="text-signal underline underline-offset-4">Derek Sivers' /now page idea</a
      >.
    </p>
  </div>
</Base>
