---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';
import { LENS_LABELS } from '../content.config';
import { getCareer, getPlatforms, formatRange, formatDuration } from '../lib/content';

/**
 * Web-native resume — real HTML, indexable, and generated from the SAME
 * career.json that feeds the /work timeline. That's the point: the two can't
 * drift, because there's only one file.
 *
 * The PDF is manually maintained in /public for now. Generating it at build
 * time with Puppeteer was considered and dropped; it isn't worth the build complexity
 * until the content settles.
 */

const career = await getCareer();
const platforms = await getPlatforms();
const handsOn = platforms.filter((p) => p.data.tier === 'hands-on');
const familiarity = platforms.filter((p) => p.data.tier === 'familiarity');
---

<Base
  title="Resume"
  description={`Resume for ${site.name} — ${site.role} in ${site.location.city}, ${site.location.region}.`}
>
  <div class="shell pt-14 pb-20 sm:pt-20">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="annotation">Resume</p>
        <h1 class="font-display mt-3 text-3xl font-semibold sm:text-4xl">{site.name}</h1>
        <p class="text-ink-muted mt-2">
          {site.role} · {site.location.city}, {site.location.region}
        </p>
        <p class="mt-1 text-sm">
          <a href={`mailto:${site.email}`} class="text-signal underline underline-offset-4">
            {site.email}
          </a>
        </p>
      </div>

      <a
        href={site.resumePdf}
        class="border-line hover:border-signal hover:text-signal border px-4 py-2.5 text-sm transition-colors"
        download
      >
        Download PDF
      </a>
    </div>

    <p class="text-ink-muted max-w-measure no-print mt-8 text-sm">
      This page and the <a href="/work" class="text-signal underline underline-offset-4">timeline</a
      >
      are generated from the same file, so they can't disagree with each other.
    </p>

    <!-- Experience -->
    <section class="mt-14" aria-labelledby="experience">
      <h2 id="experience" class="annotation border-line border-b pb-2">Experience</h2>

      <ol class="mt-8 grid gap-10">
        {
          career.map((job) => (
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="font-display text-lg font-semibold">
                  {job.data.role}
                  <span class="text-ink-muted font-medium"> · {job.data.company}</span>
                </h3>
                <span class="annotation">
                  {formatRange(job.data.start, job.data.end)} ·{' '}
                  {formatDuration(job.data.start, job.data.end)}
                </span>
              </div>

              <p class="annotation mt-1">{job.data.location}</p>
              <p class="text-ink-muted mt-3 text-sm leading-relaxed">{job.data.summary}</p>

              <ul class="mt-3 grid gap-1.5">
                {job.data.highlights.map((h) => (
                  <li class="relative pl-4 text-sm leading-relaxed">
                    <span class="bg-signal absolute top-[0.6875rem] left-0 h-px w-[0.4375rem]" />
                    {h}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Platforms -->
    <section class="mt-14" aria-labelledby="platforms">
      <h2 id="platforms" class="annotation border-line border-b pb-2">Platforms</h2>

      <dl class="mt-6 grid gap-5 text-sm">
        <div>
          <dt class="font-display font-semibold">Hands-on build</dt>
          <dd class="text-ink-muted mt-1">{handsOn.map((p) => p.data.name).join(' · ')}</dd>
        </div>
        <div>
          <dt class="font-display font-semibold">Landscape familiarity</dt>
          <dd class="text-ink-muted mt-1">{familiarity.map((p) => p.data.name).join(' · ')}</dd>
        </div>
      </dl>
      <p class="text-ink-muted mt-4 text-sm">
        The difference between those two lines is explained on the
        <a href="/work" class="text-signal underline underline-offset-4">work page</a>.
      </p>
    </section>

    <!-- Focus areas, derived from the same lens tags the timeline filters on -->
    <section class="mt-14" aria-labelledby="focus">
      <h2 id="focus" class="annotation border-line border-b pb-2">Focus areas</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          Object.values(LENS_LABELS).map((label) => (
            <li class="border-line text-ink-muted border px-3 py-1.5 text-sm">{label}</li>
          ))
        }
      </ul>
    </section>

    <!-- Other systems -->
    <section class="mt-14" aria-labelledby="systems">
      <h2 id="systems" class="annotation border-line border-b pb-2">Systems &amp; tooling</h2>

      <dl class="mt-6 grid gap-5 text-sm">
        <div>
          <dt class="font-display font-semibold">System administration</dt>
          <dd class="text-ink-muted mt-1">{site.otherSystems.administration.join(' · ')}</dd>
        </div>
        <div>
          <dt class="font-display font-semibold">Data &amp; project delivery</dt>
          <dd class="text-ink-muted mt-1">{site.otherSystems.delivery.join(' · ')}</dd>
        </div>
        <div>
          <dt class="font-display font-semibold">AI</dt>
          <dd class="text-ink-muted mt-1">{site.otherSystems.ai.join(' · ')}</dd>
        </div>
      </dl>
    </section>

    <!-- Education & certifications -->
    <section class="mt-14 grid gap-10 sm:grid-cols-2">
      <div>
        <h2 class="annotation border-line border-b pb-2">Education</h2>
        <ul class="mt-6 grid gap-4 text-sm">
          {
            site.alumniOf.map((school) => (
              <li>
                <p class="font-display font-semibold">{school.credential}</p>
                <p class="text-ink-muted mt-0.5">
                  {school.name}, {school.year}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="annotation border-line border-b pb-2">Certifications</h2>
        <ul class="mt-6 grid gap-4 text-sm">
          {
            site.certifications.map((cert) => (
              <li>
                <p class="font-display font-semibold">{cert.name}</p>
                <p class="text-ink-muted mt-0.5">{cert.status}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Base>
