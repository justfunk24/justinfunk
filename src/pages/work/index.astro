---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import PatchPanel from '../../components/PatchPanel.astro';
import { getCaseStudies, getCareer } from '../../lib/content';

const caseStudies = await getCaseStudies();
const career = await getCareer();

/* The intro sentence counts companies, roles, and return stints. These were
   hardcoded and went stale: it claimed RingCentral three times, when three
   RingCentral *roles* were actually two stints with Cloud Elements between
   them. Deriving them means adding or moving a role can't leave the prose
   quietly wrong.

   A stint is a run of consecutive roles at one company. Walking the timeline
   in order, a new stint begins whenever the previous role was somewhere else —
   so two roles back to back at one employer count once, and a return after
   time elsewhere counts again. */
const chronological = [...career].sort((a, b) => a.data.start.localeCompare(b.data.start));

const stints = new Map<string, number>();
chronological.forEach((job, i) => {
  const previous = chronological[i - 1];
  if (!previous || previous.data.company !== job.data.company) {
    stints.set(job.data.company, (stints.get(job.data.company) ?? 0) + 1);
  }
});

const companyCount = stints.size;

// The employer he returned to. Named explicitly because a repeat is the
// interesting part of a timeline, not a thing to gloss over.
const [returnedTo, returnCount] = [...stints.entries()].sort((a, b) => b[1] - a[1])[0];
const rolesThere = career.filter((j) => j.data.company === returnedTo).length;

/* Spelled out rather than rendered as digits: this is a sentence, and "6
   companies" reads like a spreadsheet. Both lists fall back to the digit above
   the range they cover, which no plausible career will reach. */
const spell = (n: number) =>
  ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][n] ??
  String(n);

const times = (n: number) => ['never', 'once', 'twice', `${spell(n)} times`][n] ?? `${n} times`;

const capitalise = (word: string) => word.charAt(0).toUpperCase() + word.slice(1);
---

<Base
  title="Work"
  description="Ten years across AT&T, RingCentral, Cloud Elements, Twilio, Northwestern Mutual, and Matrice — with an honest accounting of which platforms Justin Funk has built on and which he has only evaluated."
>
  <div class="shell pt-14 pb-16 sm:pt-20">
    <p class="annotation">Work</p>
    <h1 class="font-display mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl">
      The record, and the receipts behind it
    </h1>
    <p class="text-ink-muted max-w-measure mt-5">
      {capitalise(spell(companyCount))} companies across a decade, including {returnedTo}{' '}
      {times(returnCount)} across {spell(rolesThere)} roles. Below: the timeline you can refilter for
      the role you're hiring, the platform matrix that says plainly what I've built on, and the case studies
      that show the work.
    </p>
  </div>

  <div class="shell pb-16 sm:pb-24">
    <Timeline />
  </div>

  <PatchPanel />

  <!-- Case study index -->
  <section class="shell py-16 sm:py-24" aria-labelledby="studies-heading">
    <p class="annotation">Case studies</p>
    <h2 id="studies-heading" class="font-display mt-3 text-2xl font-semibold sm:text-3xl">
      The depth layer behind the resume bullets
    </h2>

    <ul class="border-line mt-8 border-t">
      {
        caseStudies.map((study) => (
          <li class="border-line border-b">
            <a
              href={`/work/${study.id}`}
              class="hover:bg-signal-wash group grid gap-4 py-6 transition-colors sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-8 sm:px-2"
            >
              <div>
                <span class="font-display group-hover:text-copper block text-2xl font-semibold tracking-tight transition-colors">
                  {study.data.metric.value}
                </span>
                <span class="annotation mt-1 block normal-case">{study.data.metric.label}</span>
              </div>

              <div>
                <div class="flex flex-wrap items-baseline gap-x-3">
                  <h3 class="font-display group-hover:text-signal text-lg font-semibold transition-colors">
                    {study.data.title}
                  </h3>
                  {study.data.draft && <span class="annotation text-copper">Draft</span>}
                </div>
                <p class="annotation mt-1.5">
                  {study.data.company} · {study.data.period}
                </p>
                <p class="text-ink-muted mt-3 text-sm leading-relaxed">{study.data.summary}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
