---
import { home } from '../lib/site';
import { getPublishedCaseStudyPaths } from '../lib/content';

/**
 * Five hard numbers, each linking to the case study that substantiates it.
 *
 * The one rule enforced here: a number never links somewhere that doesn't
 * exist. Case studies still in draft are stripped from production builds, so
 * their proof points render as plain text instead of a 404. On a site whose
 * entire argument is "every claim is verifiable," a dead verification link
 * would be the worst possible bug.
 */

const published = await getPublishedCaseStudyPaths();

const points = home.proof.map((p) => ({
  ...p,
  // Only keep the link if its destination is really in this build.
  href: p.href && published.has(p.href) ? p.href : null,
}));
---

<section class="border-line border-y" aria-labelledby="proof-heading">
  <h2 id="proof-heading" class="sr-only">Track record</h2>

  <ul class="shell proof">
    {
      points.map((point) => {
        // A single element type either way, so the markup stays identical
        // whether or not the destination exists.
        const Tag = point.href ? 'a' : 'div';
        return (
          <li class="proof-cell">
            <Tag href={point.href ?? undefined} class="group block h-full">
              <span
                class:list={[
                  'font-display block text-2xl font-semibold tracking-tight sm:text-3xl',
                  point.href ? 'group-hover:text-signal transition-colors' : '',
                ]}
              >
                {point.value}
              </span>
              <span class="text-ink-muted mt-1.5 block text-sm leading-snug">{point.label}</span>
              {point.href && (
                <span class="annotation text-signal mt-2 block opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
                  Read the case study →
                </span>
              )}
            </Tag>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  /* Dividers are done with nth-child rules rather than conditional classes in
     the markup. With five items in a two-column grid, "is this cell first in
     its row?" changes at every breakpoint, and class logic that assumed pairs
     left the odd fifth item with mismatched borders. CSS knows the grid; the
     template doesn't have to. */

  .proof {
    display: grid;
    grid-template-columns: 1fr;
  }

  .proof-cell {
    padding-block: 1.25rem;
  }

  /* Single column: a rule between every pair of rows. */
  .proof-cell + .proof-cell {
    border-top: 1px solid var(--c-line);
  }

  @media (min-width: 30rem) {
    .proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .proof-cell {
      padding-block: 1.5rem;
      padding-right: 1.25rem;
    }

    /* Vertical rule on every cell in the right-hand column. */
    .proof-cell:nth-child(2n) {
      border-left: 1px solid var(--c-line);
      padding-left: 1.25rem;
    }

    /* Horizontal rule above everything except the first row. */
    .proof-cell + .proof-cell {
      border-top: 0;
    }

    .proof-cell:nth-child(n + 3) {
      border-top: 1px solid var(--c-line);
    }
  }

  @media (min-width: 64rem) {
    .proof {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .proof-cell {
      padding-block: 1.75rem;
      padding-left: 1.25rem;
      border-top: 0;
      border-left: 1px solid var(--c-line);
    }

    /* Reset the two-column rules, then rebuild for five across. */
    .proof-cell:nth-child(n + 3) {
      border-top: 0;
    }

    .proof-cell:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
