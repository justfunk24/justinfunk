# Copy to `.env` for local development. Netlify sets these in its own UI, not
# from this file. Nothing here is secret. If a real secret is ever needed, it
# belongs only in Netlify's environment variables, never in the repo.

# Canonical origin. Netlify overrides this per-context in netlify.toml so that
# deploy previews don't claim to be the production site.
SITE_URL="http://localhost:4321"

# Privacy-friendly analytics. Leave BOTH of these unset in development — the
# layout only injects the script when PUBLIC_ANALYTICS_DOMAIN has a value, so
# local page views never reach the analytics host.
# PUBLIC_ANALYTICS_DOMAIN="justinfunk.ai"
# PUBLIC_ANALYTICS_SRC="https://plausible.io/js/script.js"
