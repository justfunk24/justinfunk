---
import { home } from '../lib/site';

/**
 * THE ROUTING DIAGRAM HERO
 *
 * A reader's question arrives on the left and routes to whichever part of the
 * site answers it. It's drawn the way a call flow is drawn, because that's the
 * artifact Justin's world actually runs on.
 *
 * Built from real HTML with CSS-drawn connectors rather than a single flat
 * SVG. That matters for three reasons: the node labels are selectable text and
 * indexable, each node is a genuine <a> that keyboard and screen-reader users
 * reach normally, and the diagram can restack at 375px without any of the
 * coordinate math a fixed SVG viewBox would need.
 *
 * Motion: one orchestrated draw-in on load — the trunk extends, then the three
 * branches arrive in sequence. Nothing animates on scroll. Under
 * prefers-reduced-motion the global rule in global.css collapses every
 * duration, so the diagram lands in its final state instantly rather than
 * disappearing.
 */
---

<section class="shell pt-14 pb-16 sm:pt-24 sm:pb-24">
  <p class="annotation">Denver, Colorado</p>

  <h1
    class="font-display mt-4 max-w-4xl text-[1.75rem] leading-[1.15] font-semibold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem]"
  >
    {home.thesis}
  </h1>

  <!-- The diagram. `role="group"` with a label tells assistive tech this is one
       coherent figure; the links inside remain individually navigable. -->
  <div class="diagram mt-12 sm:mt-16" role="group" aria-label="Where to go next">
    <div class="inbound">
      <span class="annotation inbound-tag">Inbound</span>
      <p class="inbound-question font-display text-base font-medium sm:text-lg">
        &ldquo;{home.inbound}&rdquo;
      </p>
    </div>

    <ul class="routes">
      {
        home.routes.map((route, i) => (
          <li class="route" style={`--i:${i}`}>
            <a href={route.href} class="route-link group">
              <span class="route-label font-display text-base font-semibold sm:text-lg">
                {route.label}
              </span>
              <span class="route-detail text-ink-muted mt-1 block text-sm">{route.detail}</span>
              <span class="annotation route-dest mt-2 block">
                {route.href}
                <span aria-hidden="true"> →</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* --- Layout -------------------------------------------------------------
     Mobile: the inbound question sits on top, a vertical trunk runs down the
     left, and each route hangs off it on a horizontal stub.
     Desktop (>=48rem): the same diagram rotated — inbound on the left, trunk
     vertical in the middle, routes fanning to the right.
     ---------------------------------------------------------------------- */

  .diagram {
    display: grid;
    gap: 1.5rem;
  }

  .inbound {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .inbound-tag {
    /* A small port marker, so the question reads as arriving on a line. */
    position: relative;
    padding-left: 0.875rem;
  }

  .inbound-tag::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    transform: translateY(-50%);
    border: 1px solid var(--c-signal);
    border-radius: 50%;
    background: var(--c-ground);
  }

  .inbound-question {
    color: var(--c-ink);
  }

  .routes {
    display: grid;
    gap: 0;
    /* The trunk: one continuous vertical rule the branches connect to. */
    position: relative;
    padding-left: 1.75rem;
  }

  .routes::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--c-line);
    transform-origin: top;
    animation: trunk-draw 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .route {
    position: relative;
    animation: branch-in 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
    /* Stagger, driven by the --i custom property set on each <li>. */
    animation-delay: calc(360ms + var(--i) * 110ms);
  }

  /* The elbow stub joining each route to the trunk. */
  .route::before {
    content: '';
    position: absolute;
    left: -1.75rem;
    top: 1.9rem;
    width: 1.75rem;
    height: 1px;
    background: var(--c-line);
  }

  /* The port where the stub meets the node. Fills with signal on hover/focus,
     which is the only color change in the whole hero. */
  .route::after {
    content: '';
    position: absolute;
    left: -0.3125rem;
    top: 1.65rem;
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: var(--c-ground);
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .route:hover::after,
  .route:focus-within::after {
    background: var(--c-signal);
    border-color: var(--c-signal);
  }

  .route-link {
    display: block;
    padding: 1.25rem 0 1.25rem 1.25rem;
    border-bottom: 1px solid var(--c-line);
    transition: background-color 160ms ease;
  }

  .route:last-child .route-link {
    border-bottom: 0;
  }

  .route-link:hover {
    background: var(--c-signal-wash);
  }

  .route-link:hover .route-label {
    color: var(--c-signal);
  }

  .route-label {
    transition: color 160ms ease;
  }

  .route-dest {
    color: var(--c-ink-muted);
    transition: color 160ms ease;
  }

  .route-link:hover .route-dest {
    color: var(--c-signal);
  }

  @media (min-width: 48rem) {
    .diagram {
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
      gap: 0 3.5rem;
      align-items: start;
    }

    .inbound {
      display: block;
      position: relative;
    }

    /* The span that makes this a diagram rather than two columns: a horizontal
       run from the inbound question across the gutter, landing on the top of
       the trunk. Without it the question and the routes read as unrelated
       blocks and the whole call-flow metaphor collapses. */
    .inbound::after {
      content: '';
      position: absolute;
      top: 0.4rem;
      right: -3.5rem;
      width: 3.5rem;
      height: 1px;
      background: var(--c-line);
    }

    /* Trunk begins exactly where the inbound run lands, forming a clean elbow. */
    .routes::before {
      top: 0.4rem;
    }

    .inbound-question {
      margin-top: 0.5rem;
    }
  }

  /* --- Motion -------------------------------------------------------------
     Two keyframes, one sequence, fired once on load. The reduced-motion rule
     in global.css collapses these durations to ~0, and because both animations
     use `both` fill mode the elements settle at their final frame rather than
     staying at the initial one. That's what keeps the diagram visible when
     motion is off.
     ---------------------------------------------------------------------- */

  @keyframes trunk-draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes branch-in {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
