---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/content';

const posts = await getPosts();

// Every tag that actually appears on a published post.
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base
  title="Injection of Funk"
  description="Writing on customer experience, contact center platforms, and putting AI to work in enterprise engagement — by Justin Funk."
>
  <div class="shell pt-14 pb-20 sm:pt-20">
    <p class="annotation">Injection of Funk</p>
    <h1 class="font-display mt-3 max-w-3xl text-3xl font-semibold sm:text-4xl">
      Opinions about contact centers, with the data underneath
    </h1>
    <p class="text-ink-muted max-w-measure mt-5">
      Everything here lives here first. LinkedIn gets a copy — this is the original, and the comment
      threads worth reading are linked from each post.
    </p>

    <p class="mt-5">
      <a href="/writing/rss.xml" class="text-signal text-sm underline underline-offset-4">
        Subscribe by RSS →
      </a>
    </p>

    {
      tags.length > 1 && (
        <div class="mt-10" data-writing-filters hidden>
          <fieldset class="border-0 p-0">
            <legend class="annotation">Filter by tag</legend>
            <div class="mt-3 flex flex-wrap gap-2">
              <button
                type="button"
                class="border-line border px-3.5 py-1.5 text-sm filter"
                data-tag="all"
                aria-pressed="true"
              >
                All
              </button>
              {tags.map((tag) => (
                <button
                  type="button"
                  class="border-line border px-3.5 py-1.5 text-sm filter"
                  data-tag={tag}
                  aria-pressed="false"
                >
                  {tag}
                </button>
              ))}
            </div>
          </fieldset>
          <p class="sr-only" role="status" data-writing-status />
        </div>
      )
    }

    {
      posts.length > 0 ? (
        <ul class="border-line mt-12 border-t" data-writing-list>
          {posts.map((post) => (
            <li class="border-line border-b" data-tags={post.data.tags.join('|')}>
              <article class="py-8 sm:px-2">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="annotation">{formatDate(post.data.date)}</span>
                  {post.data.draft && <span class="annotation text-copper">Draft</span>}
                </div>

                <h2 class="font-display mt-2 text-xl font-semibold">
                  <a href={`/writing/${post.id}`} class="hover:text-signal transition-colors">
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-ink-muted max-w-measure mt-3 leading-relaxed">{post.data.hook}</p>

                <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
                  {post.data.tags.length > 0 && (
                    <ul class="flex flex-wrap gap-1.5" aria-label="Tags">
                      {post.data.tags.map((tag) => (
                        <li class="border-line text-ink-muted border px-2 py-0.5 font-mono text-[0.6875rem]">
                          {tag}
                        </li>
                      ))}
                    </ul>
                  )}

                  <a
                    href={`/writing/${post.id}`}
                    class="text-signal text-sm underline underline-offset-4"
                  >
                    Read →
                  </a>

                  {post.data.linkedinUrl && (
                    <a
                      href={post.data.linkedinUrl}
                      rel="noopener"
                      class="text-ink-muted hover:text-ink text-sm transition-colors"
                    >
                      Discuss on LinkedIn →
                    </a>
                  )}
                </div>

                {post.data.question && (
                  <p class="border-line text-ink-muted mt-5 border-l-2 pl-4 text-sm italic">
                    {post.data.question}
                  </p>
                )}
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-ink-muted border-line mt-12 border border-dashed p-6 text-sm">
          Nothing published yet.
        </p>
      )
    }
  </div>
</Base>

<style>
  .filter {
    color: var(--c-ink-muted);
    background: transparent;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .filter:hover {
    color: var(--c-ink);
    border-color: var(--c-ink-muted);
  }

  .filter[aria-pressed='true'] {
    color: var(--c-ground);
    background: var(--c-ink);
    border-color: var(--c-ink);
  }

  [data-hidden='true'] {
    display: none;
  }
</style>

<script>
  const filters = document.querySelector<HTMLElement>('[data-writing-filters]');
  const list = document.querySelector<HTMLElement>('[data-writing-list]');

  if (filters && list) {
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('.filter'));
    // `:scope >` matters here. Each post card contains its own <li> tag chips,
    // so a bare 'li' selector matches those too — it reported 12 items for 3
    // posts and hid the tag chips along with the cards.
    const items = Array.from(list.querySelectorAll<HTMLElement>(':scope > li'));
    const status = filters.querySelector<HTMLElement>('[data-writing-status]');

    // Controls only appear once we know they'll do something.
    filters.removeAttribute('hidden');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tag ?? 'all';
        let shown = 0;

        items.forEach((item) => {
          const tags = (item.dataset.tags ?? '').split('|');
          const match = tag === 'all' || tags.includes(tag);
          item.dataset.hidden = String(!match);
          if (match) shown += 1;
        });

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));

        if (status) {
          status.textContent =
            tag === 'all'
              ? `Showing all ${items.length} posts.`
              : `Showing ${shown} of ${items.length} posts tagged ${tag}.`;
        }
      });
    });
  }
</script>
