---
import { nav, site } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

/** A nav item is "current" on its own page and on anything nested under it,
 *  so /work/matrice still highlights Work. */
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-line bg-ground/85 sticky top-0 z-50 border-b backdrop-blur">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="font-display hover:text-signal shrink-0 text-[0.9375rem] font-semibold tracking-tight whitespace-nowrap transition-colors"
      aria-label={`${site.name} — home`}
    >
      {site.name}
    </a>

    {
      /* min-w-0 on both the nav and the list is what actually lets the
        overflow-x container shrink. A flex item defaults to min-width:auto,
        so without it the strip refuses to compress and widens the whole
        document instead of scrolling — a horizontal scrollbar on the page. */
    }
    <nav aria-label="Main" class="flex min-w-0 items-center gap-1">
      {
        /* The full nav collapses to a horizontally scrollable strip rather than
          a hamburger. Five short items fit on a 375px screen, and a menu that
          costs a tap is worse than a menu you can see. */
      }
      <ul
        class="nav-strip -mx-1 flex min-w-0 scrollbar-none items-center gap-0.5 overflow-x-auto px-1 sm:gap-1"
      >
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'block px-2 py-1.5 text-sm whitespace-nowrap transition-colors sm:px-3',
                  isCurrent(item.href) ? 'text-ink font-medium' : 'text-ink-muted hover:text-ink',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          /* Contact lives inside the scrolling strip so it's present at every
            width. The brief calls for a nav contact button on every page, and
            hiding it below 640px would have quietly dropped it on phones. */
        }
        <li class="pl-1">
          <a
            href="/contact"
            aria-current={isCurrent('/contact') ? 'page' : undefined}
            class="border-line hover:border-signal hover:text-signal block border px-3 py-1.5 text-sm whitespace-nowrap transition-colors"
          >
            Contact
          </a>
        </li>
      </ul>

      <div class="ml-1 flex shrink-0 items-center sm:ml-2">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<style>
  /* Hide the scrollbar on the nav strip without disabling scrolling. */
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  /* On narrow screens the six nav items don't fit, so the strip scrolls. A
     hidden scrollbar makes that undiscoverable, so fade the trailing edge —
     the clipped item reads as "there's more this way" rather than as a bug.
     The mask lifts once everything fits. */
  @media (max-width: 47.99rem) {
    .nav-strip {
      mask-image: linear-gradient(to right, black calc(100% - 1.5rem), transparent 100%);
    }
  }
</style>
